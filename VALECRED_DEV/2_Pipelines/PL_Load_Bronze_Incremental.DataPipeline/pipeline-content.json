        "description": "A atividade Filter pega uma lista (um array) e cria uma nova lista contendo apenas os itens que atendem a uma condição.",
        "dependsOn": [
          {
            "activity": "Lookup_GetTableList",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "Filter",
        "typeProperties": {
          "items": {
            "value": "@activity('Lookup_GetTableList').output.value",
            "type": "Expression"
          },
          "condition": {
            "value": "@empty(item().InclusionWatermark)",
            "type": "Expression"
          }
        },
