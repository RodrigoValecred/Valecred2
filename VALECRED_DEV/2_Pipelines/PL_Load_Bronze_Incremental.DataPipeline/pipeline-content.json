      {
        "type": "ForEach",
        "typeProperties": {
          "batchCount": 50,
          "items": {
            "value": "@activity('Filter_IncrementalTables').output.value",
            "type": "Expression"
          },
          "activities": [
            {
              "type": "Copy",
              "typeProperties": {
                "source": {
                  "type": "MySqlSource",
                  "query": {
                    "value": "@concat(\n    'SELECT * FROM ', item().TableName,\n    ' WHERE ',\n    'GREATEST(IFNULL(', item().UpdateWatermark, ', ''1900-01-01''), ', item().InclusionWatermark, ')',\n    ' > ''', variables('LastRunDate'), '''',\n    ' AND GREATEST(IFNULL(', item().UpdateWatermark, ', ''1900-01-01''), ', item().InclusionWatermark, ')',\n    ' <= ''', variables('TargetProcessingDate'), ''''\n)",
                    "type": "Expression"
                  },
                  "datasetSettings": {
                    "type": "MySqlTable",
                    "schema": [],
                    "externalReferences": {
                      "connection": "44a3c055-a006-453e-8038-01652e18ab84"
                    },
                    "annotations": []
                  }
