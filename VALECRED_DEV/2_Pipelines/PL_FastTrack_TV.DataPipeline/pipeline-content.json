        "typeProperties": {
          "source": {
            "type": "MySqlSource",
            "query": "SELECT \n    NBORDERO,\n    TOTFAC AS VOLUME_OPERADO,\n    TTO,\n    STATUSACEITE,\n    STATUSANALISE,\n    DATAINCLUSAO,   \n    DATATRAVA,\n    DATAANALISE,\n    CODCLIENTE,\n    CPFCNPJCLIENTE,\n    CASE \n        WHEN DATAANALISE IS NULL OR HOUR(DATAANALISE) < 9 OR HOUR(DATAANALISE) > 18\n             THEN 9\n        ELSE \n            HOUR(DATAANALISE) END AS HORA,\n    TIMESTAMPDIFF(\n        MINUTE,\n        COALESCE(DATATRAVA,DATAINCLUSAO),\n        COALESCE(DATAANALISE,  NOW())\n    ) AS TEMPO_ANALISE\nFROM tab_operacoes\nWHERE    \n    (DATE(DATAANALISE) = CURDATE() OR DATAANALISE IS NULL)\n    AND TTO IN ('CM', 'FC', 'NO', 'GR', 'NC')\n    AND DATAINCLUSAO >= DATE_SUB(NOW(), INTERVAL 30 DAY)\nORDER BY DATAINCLUSAO DESC",
