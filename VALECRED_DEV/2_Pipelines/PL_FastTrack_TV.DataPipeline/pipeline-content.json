              "typeProperties": {
                "source": {
                  "type": "MySqlSource",
                  "query": "SELECT \n    NBORDERO,\n    TOTFAC AS VOLUME_OPERADO,\n    TTO,\n    STTO,\n    STATUSACEITE,\n    STATUSANALISE,\n    DATAINCLUSAO,   \n    DATATRAVA,\n    DATAANALISE,\n    CODCLIENTE,\n    CPFCNPJCLIENTE,\n    CASE \n        WHEN DATAANALISE IS NULL OR HOUR(DATAANALISE) < 9 OR HOUR(DATAANALISE) > 18\n             THEN 9\n        ELSE \n            HOUR(DATAANALISE) END AS HORA,\n    TIMESTAMPDIFF(\n        MINUTE,\n        COALESCE(DATATRAVA,DATAINCLUSAO),\n        CASE WHEN STATUSANALISE = \"P\" \n            THEN NOW() \n            ELSE COALESCE(DATAANALISE,  NOW()) END\n    ) AS TEMPO_ANALISE\nFROM tab_operacoes\nWHERE    \n    (DATE(DATAANALISE) = CURDATE() OR DATAANALISE IS NULL OR (DATAANALISE < CURDATE() AND STATUSANALISE NOT IN (\"D\",\"I\")))\n    AND TTO IN ('CM', 'FC', 'NO', 'GR', 'NC')\n    AND DATAINCLUSAO >= DATE_SUB(NOW(), INTERVAL 30 DAY)\nORDER BY DATAINCLUSAO DESC",
                  "datasetSettings": {
                    "type": "MySqlTable",
