            "query": "SELECT \n    NBORDERO,\n    TOTFAC AS VOLUME_OPERADO,\n    TTO,\n    STATUSACEITE,\n    STATUSANALISE,\n    DATAINCLUSAO,   \n    DATATRAVA,\n    DATAANALISE,\n    CODCLIENTE,\n    CASE \n        WHEN HOUR(DATAINCLUSAO) < 9 OR HOUR(DATAINCLUSAO) > 18\n             THEN 9\n        ELSE \n            HOUR(DATAINCLUSAO) END AS HORA,\n    TIMESTAMPDIFF(\n        MINUTE,\n        DATATRAVA,\n         COALESCE(DATAANALISE,  NOW())\n    ) AS TEMPO_ANALISE\nFROM tab_operacoes\nWHERE    \n    (DATE(DATAANALISE) = CURDATE() OR DATAANALISE IS NULL)\n    AND TTO IN ('CM', 'FC', 'NO', 'GR', 'NC')\n    AND DATAINCLUSAO >= DATE_SUB(NOW(), INTERVAL 30 DAY)\nORDER BY DATAINCLUSAO DESC",
