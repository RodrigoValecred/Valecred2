              "typeProperties": {
                "source": {
                  "type": "MySqlSource",
                  "query": "SELECT * FROM \n(SELECT \n    o.NBORDERO as id_operacao,\n    cast(sum(t.VALOR) as decimal(18,2)) AS valor_titulo,\n    cast(sum(CASE WHEN t.DOCCONFIRMADO IN ('A', 'P') OR t.DOCCONFIRMADO IS NULL OR t.DOCCONFIRMADO = '' THEN t.VALOR ELSE 0 END) as decimal(18,2)) AS vlr_titulos_nao_checados,\n    o.TTO,\n    o.STTO,\n    o.STATUSACEITE,\n    o.STATUSANALISE,\n    t.ACEITO,\n    o.DATAINCLUSAO,   \n    o.DATATRAVA,\n    o.DATAANALISE,\n    o.CODCLIENTE,\n    o.CPFCNPJCLIENTE,\n    t.CPFCNPJSACADO as cpf_cnpj_sacado,\n    MAX(o.FATOR) as taxa_aquisicao, -- Renomeado\n    AVG(t.PRAZO) as prazo_medio,\n    COUNT(t.CODTITULO) AS QTD_TITULOS\nFROM tab_operacoes o \nJOIN tab_titulos t ON t.CODOPERACAO = o.CODOPERACAO\nWHERE    \n    (DATE(o.DATAANALISE) = CURDATE() OR o.DATAANALISE IS NULL)\n    AND o.TTO IN ('CM', 'FC', 'NO', 'GR', 'NC')\n    AND o.DATAINCLUSAO >= DATE_SUB(NOW(), INTERVAL 30 DAY)\nGROUP BY t.CPFCNPJSACADO, o.NBORDERO, o.TTO, o.STTO, o.STATUSACEITE, o.STATUSANALISE, t.ACEITO, o.DATAINCLUSAO, o.DATATRAVA, o.DATAANALISE, o.CODCLIENTE, o.CPFCNPJCLIENTE) as subs",
