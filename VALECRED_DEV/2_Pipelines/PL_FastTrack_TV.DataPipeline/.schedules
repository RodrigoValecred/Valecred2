{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/gitIntegration/schedules/1.0.0/schema.json",
  "schedules": [
    {
      "enabled": true,
      "jobType": "Execute",
      "configuration": {
        "type": "Cron",
        "startDateTime": "2026-01-05T09:00:00",
        "endDateTime": "2026-01-09T18:00:00",
        "localTimeZoneId": "E. South America Standard Time",
        "interval": 6
      }
    }
  ]
}