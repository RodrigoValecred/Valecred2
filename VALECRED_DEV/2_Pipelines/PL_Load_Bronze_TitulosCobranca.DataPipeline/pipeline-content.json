              "value": "@concat('SELECT * FROM tab_titulos_cobranca WHERE DATAINCLUSAO > ''', activity('Get_Last_Watermark').output.firstRow.LastWatermarkValue, ''' AND DATAINCLUSAO <= ''', variables('TargetDate'), '''')",
              "type": "Expression"
            },
